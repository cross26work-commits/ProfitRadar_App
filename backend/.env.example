APP_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required by backend database operations. There is no anon-key fallback.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5.6-terra
OPENAI_MODEL_ESCALATION=gpt-5.6-sol
OPENAI_MODEL_STANDARD=gpt-5.6-sol
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for Gmail credential storage. Backend-only Fernet keys, newest first.
# Retain previous key during a reviewed rotation; never commit actual keys.
GMAIL_TOKEN_ENCRYPTION_KEYS=
GOOGLE_REDIRECT_URI=
# For production/staging, callback must be HTTPS /gmail/callback; scheduler
# endpoint must be HTTPS or an explicit loopback HTTP sidecar.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
OAUTH_STATE_SECRET=
GMAIL_SCHEDULER_SECRET=
SCHEDULER_BACKEND_URL=http://127.0.0.1:8000
AI_MONTHLY_GENERATION_LIMIT=100
# Fail closed until explicitly configured. Rates are operator-verified MAXIMUM
# USD per million tokens, not vendor prices. Never put keys into this JSON.
# Production startup requires rates for ALL three configured model names.
# Verify current official prices and choose conservative maximums before deploy:
# https://developers.openai.com/api/docs/pricing
AI_MODEL_MAX_RATES_JSON=
AI_COMPANY_MONTHLY_TOKENS=
AI_COMPANY_MONTHLY_USD=
# Required before account deletion; owner must approve a retention policy.
ACCOUNT_AUDIT_RETENTION_DAYS=
RETENTION_SWEEP_APPROVED=false
# Backend-only support administration and abuse controls. Use Supabase Auth UUIDs;
# never use tenant profile roles as administrator authority.
SUPPORT_ADMIN_USER_IDS=
CONTACT_RATE_LIMIT_SECRET=
SUPPORT_RETENTION_DAYS=365
SUPPORT_EMAIL_PROVIDER=
SUPPORT_EMAIL_FROM=
SUPPORT_EMAIL_VERIFIED_DOMAIN=
SUPPORT_EMAIL_SENDER_APPROVED=false
SUPPORT_EMAIL_SMTP_HOST=
SUPPORT_EMAIL_SMTP_PORT=465
SUPPORT_EMAIL_SMTP_USERNAME=
SUPPORT_EMAIL_SMTP_PASSWORD=
TERMS_VERSION=2026-09-29
# Optional HTTPS operational receiver. No customer rows; --notify opts in.
MONITORING_WEBHOOK_URL=
# Loopback-only health endpoint exposed by sync_worker for the local probe.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8025
WORKER_HEALTH_URL=http://127.0.0.1:8025
GMAIL_SYNC_INTERVAL_SECONDS=300
WORKER_MAX_BACKOFF_SECONDS=3600
# Default test. Never enable live or use real keys without a separate approval.
STRIPE_MODE=test
BILLING_LIVE_APPROVED=false
BILLING_LIVE_APPROVAL_REF=
# Live also requires production/HTTPS and the DB promotion gate (empty billing history).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Production requires approved LIVE mode and rejects test credentials. Staging
# may use TEST. Startup checks the TEST/LIVE key prefix against STRIPE_MODE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
