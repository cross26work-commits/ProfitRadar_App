APP_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required by backend database operations. There is no anon-key fallback.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for Gmail credential storage. Backend-only Fernet keys, newest first.
# Retain previous key during a reviewed rotation; never commit actual keys.
GMAIL_TOKEN_ENCRYPTION_KEYS=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=http://localhost:3000
OAUTH_STATE_SECRET=
GMAIL_SCHEDULER_SECRET=
SCHEDULER_BACKEND_URL=http://127.0.0.1:8000
AI_MONTHLY_GENERATION_LIMIT=100
# Fail closed until explicitly configured. Rates are operator-verified MAXIMUM
# USD per million tokens, not vendor prices. Never put keys into this JSON.
AI_MODEL_MAX_RATES_JSON=
AI_COMPANY_MONTHLY_TOKENS=
AI_COMPANY_MONTHLY_USD=
# Required before account deletion; owner must approve a retention policy.
ACCOUNT_AUDIT_RETENTION_DAYS=
RETENTION_SWEEP_APPROVED=false
# Optional HTTPS operational receiver. No customer rows; --notify opts in.
MONITORING_WEBHOOK_URL=
# Default test. Never enable live or use real keys without a separate approval.
STRIPE_MODE=test
BILLING_LIVE_APPROVED=false
BILLING_LIVE_APPROVAL_REF=
# Live also requires production/HTTPS and the DB promotion gate (empty billing history).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
