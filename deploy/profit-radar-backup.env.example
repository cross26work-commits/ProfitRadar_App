# Install as /etc/profit-radar/backup.env with mode 0600 from the secret store.
APP_ENV=production
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=postgres
PGPASSWORD=
PGSSLMODE=verify-full
BACKUP_DIR=/var/backups/profit-radar
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=/etc/profit-radar/backup-age-identity.txt
BACKUP_RETENTION_DAYS=
