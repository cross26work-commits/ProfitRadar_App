{
  "version": 1,
  "provider": "railway",
  "project": "owner-created-empty-production-project",
  "services": {
    "frontend": {
      "rootDirectory": "/frontend",
      "buildCommand": "npm ci && npm run build",
      "startCommand": "npm run start -- --hostname 0.0.0.0 --port $PORT",
      "healthcheckPath": "/",
      "restartPolicy": "ON_FAILURE",
      "publicDomain": "profitradar.jp",
      "dependsOn": ["backend"]
    },
    "backend": {
      "rootDirectory": "/backend",
      "buildCommand": "python -m pip install --no-cache-dir -r requirements.txt",
      "startCommand": "python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT",
      "healthcheckPath": "/ready",
      "restartPolicy": "ON_FAILURE",
      "publicDomain": "api.profitradar.jp",
      "dependsOn": ["supabase"]
    },
    "worker": {
      "rootDirectory": "/backend",
      "buildCommand": "python -m pip install --no-cache-dir -r requirements.txt",
      "startCommand": "python -m scripts.sync_worker",
      "healthcheckPath": "/health",
      "restartPolicy": "ON_FAILURE",
      "publicDomain": null,
      "privateDomain": "worker.railway.internal",
      "dependsOn": ["backend"]
    }
  },
  "deploymentOrder": ["database-verification", "backend", "frontend", "worker"],
  "automaticMigrationOnDeploy": false
}
